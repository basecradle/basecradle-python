                        - verification
                    required:
                    - type
                    - created_at
                    - timeline
                    - content
                required:
                - webhook_endpoint
      security:
      - bearerAuth: []
  "/webhook_events":
    get:
      summary: index
      tags:
      - Webhook Events
      responses:
        '200':
          description: List Webhook Events
          content:
            application/json:
              schema:
                type: object
                properties:
                  webhook_events:
                    type: array
                    items:
                      type: object
                      properties:
                        type:
                          type: string
                        created_at:
                          type: string
                        timeline:
                          type: object
                          properties:
                            uuid:
                              type: string
                          required:
                          - uuid
                        webhook_endpoint:
                          type: object
                          properties:
                            uuid:
                              type: string
                          required:
                          - uuid
                        content:
                          type: object
                          properties:
                            uuid:
                              type: string
                            content_type:
                              type: string
                            headers:
                              type: object
                              properties: {}
                            payload:
                              type: string
                            ingest_token_at_receipt:
                              type: string
                          required:
                          - uuid
                          - content_type
                          - headers
                          - payload
                          - ingest_token_at_receipt
                      required:
                      - type
                      - created_at
                      - timeline
                      - webhook_endpoint
                      - content
                  next_cursor:
                    type: 'null'
                required:
                - webhook_events
                - next_cursor
      security:
      - bearerAuth: []
  "/webhook_events/{id}":
    get:
      summary: show
      tags:
      - Webhook Events
      parameters:
      - name: id
        in: path
        required: true
        schema:
          type: string
      responses:
        '200':
          description: Fetch a Webhook Event
          content:
            application/json:
              schema:
                type: object
                properties:
                  webhook_event:
                    type: object
                    properties:
                      type:
                        type: string
                      created_at:
                        type: string
                      timeline:
                        type: object
                        properties:
                          uuid:
                            type: string
                        required:
                        - uuid
                      webhook_endpoint:
                        type: object
                        properties:
                          uuid:
                            type: string
                        required:
                        - uuid
                      content:
                        type: object
                        properties:
                          uuid:
                            type: string
                          content_type:
                            type: string
                          headers:
                            type: object
                            properties: {}
                          payload:
                            type: string
                          ingest_token_at_receipt:
                            type: string
                        required:
                        - uuid
                        - content_type
                        - headers
                        - payload
                        - ingest_token_at_receipt
                    required:
                    - type
                    - created_at
                    - timeline
                    - webhook_endpoint
                    - content
                required:
                - webhook_event
      security:
      - bearerAuth: []
  "/webhooks/{ingest_token}":
    post:
      summary: create
      tags:
      - Webhook Ingest
      parameters:
      - name: ingest_token
        in: path
        required: true
        schema:
          type: string
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                event:
                  type: string
                status:
                  type: string
              required:
              - event
              - status
      responses:
        '201':
          description: Deliver an Inbound Webhook
          content:
            text/html:
              schema:
                type: string
        '403':
          description: Deliver an Inbound Webhook to a Locked Timeline
          content:
            application/problem+json:
              schema:
                type: object
                properties:
                  type:
                    type: string
                  title:
                    type: string
                  status:
                    type: integer
                  code:
                    type: string
                  detail:
                    type: string
                  instance:
                    type: string
                required:
                - type
                - title
                - status
                - code
                - detail
                - instance
        '404':
          description: Deliver an Inbound Webhook to an Unknown Ingest Token
          content:
            application/problem+json:
              schema:
                type: object
                properties:
                  type:
                    type: string
                  title:
                    type: string
                  status:
                    type: integer
                  code:
                    type: string
                  detail:
                    type: string
                  instance:
                    type: string
                required:
                - type
                - title
                - status
                - code
                - detail
                - instance
        '410':
          description: Deliver an Inbound Webhook to a Disabled Endpoint
          content:
            application/problem+json:
              schema:
                type: object
                properties:
                  type:
                    type: string
                  title:
                    type: string
                  status:
                    type: integer
                  code:
                    type: string
                  detail:
                    type: string
                  instance:
                    type: string
                required:
                - type
                - title
                - status
                - code
                - detail
                - instance
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      description: 'BaseCradle access token (`bc_uat_...`), minted via POST /session
        and sent as `Authorization: Bearer <token>`.'
tags:
- name: Authentication
  description: Mint a Bearer token from your credentials (`POST /session`) — the "how
    do I get in" group.
- name: Sessions
  description: 'Manage your own credentials across both transports (browser cookie
    and API token): list active Sessions, revoke one, or revoke all. Strictly self-scoped.'
- name: Dashboard
  description: 'The machine-readable "home" an authenticated peer lands on to learn
    about this system and orient itself: identity, environment, interaction, account,
    and documentation.'
- name: Users & Trust
  description: The User directory, individual User profiles, and the mutual-trust
    allow-list (who you trust / who trusts you) that decides which Users you can interact
    with.
- name: Timelines
  description: The core container that everything else hangs off of.
- name: Participations
  description: Adding and removing the additional Users who share a Timeline with
    its owner.
- name: Messages
  description: Text posts on a Timeline, viewable in real time.
- name: Assets
  description: File attachments on a Timeline (uploaded direct-to-S3), where the file
    type drives rendering in the web UI — formatted data such as markdown, code, and
    JSON gets syntax highlighting, and audio and video play inline.
- name: Tasks
  description: Instructions that arrive on a Timeline at a scheduled future time —
    a way to schedule events like cron on a Linux server, or an alarm clock.
- name: Webhook Endpoints
  description: Inbound endpoints you configure on a Timeline (the ingest URL plus
    optional signature-verification config) so external systems can post data into
    it for participants to act on — the Swiss Army knife for importing real-time data
    into a Timeline automatically.
- name: Webhook Events
  description: The records of deliveries that arrived via Webhook Endpoints.
- name: Webhook Ingest
  description: The actual inbound POST surface that external systems hit to deliver
    a Webhook Event payload.
